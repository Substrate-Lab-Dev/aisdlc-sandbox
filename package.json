{
  "name": "aisdlc-sandbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.19 <23"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
